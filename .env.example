# Copy to .env (git-ignored) next to docker-compose.yml. Every value is optional.

# Host port, published on 127.0.0.1 only. The Cloudflare tunnel connects to localhost:<port>.
STACKLIGHT_PORT=8780
# To expose the demo beyond this machine on purpose, change the bind address (0.0.0.0 = all interfaces).
# WARNING: the app has NO authentication. 0.0.0.0 exposes it (and your LLM spend) to everyone who can
# reach this host; keep 127.0.0.1 behind the Cloudflare tunnel unless you know what you are doing.
# STACKLIGHT_BIND=127.0.0.1

POSTGRES_PASSWORD=stacklight

# LLM. Set the key matching the model's provider; leave empty and runs fail cleanly with the
# "llm_unavailable" banner (the knowledge base and UI still load). Never commit real keys.
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DAILY_SPEND_CAP_USD=5
RATE_LIMIT_PER_MIN=30

# Operational settings (commented = the default shown). All are passed through docker-compose.yml.
# Behind the Cloudflare tunnel set this to true (per-IP limits then use CF-Connecting-IP). Leave false anywhere the
# app is reachable without a trusted proxy: the headers are client-supplied and spoofable.
# TRUST_PROXY_HEADERS=false
# Hours between scheduled demo resets; 0 disables. Set 0 before loading your own documents: the reset deletes
# anything outside corpus/.
# DEMO_RESET_INTERVAL_H=6
# DEMO_RESET_RETRY_S=60
# Seed the shipped corpus in the background on first start.
# AUTO_SEED=true
# MAX_STREAMS_PER_IP=4
# MAX_PENDING_RUNS=12
# MAX_CONCURRENT_RUNS=4
# RUN_TIMEOUT_S=120
# Flat USD charged for a run whose LLM calls had unknown pricing (so it cannot bypass the spend cap).
# UNKNOWN_COST_PER_RUN_USD=0.02
